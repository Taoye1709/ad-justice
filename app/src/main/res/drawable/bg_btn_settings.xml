<?xml version="1.0" encoding="utf-8"?>
<!-- 次按钮（设置）：深灰底 + 细灰描边，与主按钮明确区分。
     聚焦时橙色描边环提示当前位置。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF333333" />
            <corners android:radius="8dp" />
            <stroke android:width="3dp" android:color="#FFFF6F00" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2E2E2E" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#FF555555" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF222222" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#FF444444" />
        </shape>
    </item>
</selector>
