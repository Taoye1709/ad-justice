<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF0F0F0F"
    android:padding="32dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="@dimen/tv_title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFB0B0B0"
            android:textSize="@dimen/tv_caption_size" />
    </LinearLayout>

    <!-- Control buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp">

        <Button
            android:id="@+id/btn_start_stop"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_btn_start_stop"
            android:minHeight="64dp"
            android:paddingVertical="16dp"
            android:stateListAnimator="@animator/btn_elevation"
            android:text="@string/start_monitoring"
            android:textColor="#FFFFFFFF"
            android:textSize="@dimen/tv_button_text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_settings"
            android:minHeight="64dp"
            android:paddingVertical="16dp"
            android:stateListAnimator="@animator/btn_elevation"
            android:text="@string/settings"
            android:textColor="@color/text_btn_settings"
            android:textSize="@dimen/tv_button_text" />
    </LinearLayout>

    <!-- Hijack count -->
    <TextView
        android:id="@+id/hijack_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFE8A040"
        android:textSize="@dimen/tv_body_size"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Hijack log preview (future) -->

</LinearLayout>
