<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0F0F0F"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="#FFFFFFFF"
            android:textSize="@dimen/tv_title_size"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <Switch
            android:id="@+id/switch_dns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="@string/setting_dns_check_enabled"
            android:textColor="#FFFFFFFF"
            android:textSize="@dimen/tv_body_size"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/switch_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="@string/setting_block_enabled"
            android:textColor="#FFFFFFFF"
            android:textSize="@dimen/tv_body_size"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/setting_about" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_text"
            android:textColor="#FFB0B0B0"
            android:textSize="@dimen/tv_caption_size"
            android:fontFamily="monospace"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>
