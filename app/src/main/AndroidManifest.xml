<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions needed -->
    <!-- INTERNET is used by DNS check (raw UDP to trusted DNS servers) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ACCESS_NETWORK_STATE for getting network interface info -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Network config for DNS / Wi-Fi static override -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- FOREGROUND_SERVICE for our capture service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- FOREGROUND_SERVICE_MEDIA_PROJECTION for Android 14+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
        android:maxSdkVersion="34" />
    <!-- POST_NOTIFICATIONS for Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WRITE_EXTERNAL_STORAGE for evidence storage on older Android -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- WRITE_SECURE_SETTINGS for Private DNS switching (granted via adb) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- TV features — declare this is a TV app -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AdJustice"
        android:banner="@drawable/ic_banner"
        tools:targetApi="34">

        <!-- Home launcher entry — shows evidence list -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">

            <!-- TV Launcher intent filter -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Evidence detail screen -->
        <activity
            android:name=".ui.DetailActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Settings screen -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <!-- Foreground service that periodically captures screen for ad-detection -->
        <service
            android:name=".service.CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            android:permission="android.permission.FOREGROUND_SERVICE" />

        <service
            android:name=".vpn.AdBlockVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <service
            android:name=".proxy.HttpBlockProxyService"
            android:exported="false" />

        <receiver
            android:name=".vpn.VpnKeepAlive"
            android:exported="false" />

    </application>

</manifest>
