<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions needed -->
    <!-- INTERNET is used by DNS check (raw UDP to trusted DNS servers) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ACCESS_NETWORK_STATE for getting network interface info -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Network config for DNS / Wi-Fi static override -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- FOREGROUND_SERVICE for our capture service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- FOREGROUND_SERVICE_MEDIA_PROJECTION for Android 14+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
        android:maxSdkVersion="34" />
    <!-- POST_NOTIFICATIONS for Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WRITE_EXTERNAL_STORAGE for evidence storage on older Android -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- WRITE_SECURE_SETTINGS for Private DNS switching (granted via adb) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- RECEIVE_BOOT_COMPLETED — kept for non-WhaleyTV ROMs and compatibility -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- TV features — declare this is a TV app -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AdJustice"
        android:banner="@drawable/ic_banner"
        tools:targetApi="34">

        <!-- Home launcher entry — shows evidence list -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">

            <!-- TV Launcher intent filter -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Evidence detail screen -->
        <activity
            android:name=".ui.DetailActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Settings screen -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <!-- Foreground service that periodically captures screen for ad-detection -->
        <service
            android:name=".service.CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            android:permission="android.permission.FOREGROUND_SERVICE" />

        <service
            android:name=".vpn.AdBlockVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <service
            android:name=".proxy.HttpBlockProxyService"
            android:exported="false" />

        <receiver
            android:name=".vpn.VpnKeepAlive"
            android:exported="false" />

        <!-- Proxy restorer. WhaleyTV blacklists BOOT_COMPLETED/CONNECTIVITY_CHANGE
             for 3rd-party apps (logcat: "skip receiver package:com.adjustice").
             Boot self-start is now handled by ProxyAutoStartAccessibilityService.
             The keep-alive alarm assists during runtime. -->
        <receiver
            android:name=".receiver.ProxyBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

        <!-- 开机自启通道：系统开机直接绑定已启用的无障碍服务（不经过广播分发，
             绕开 WhaleyTV ROM 对第三方开机广播的黑名单）。BIND_ACCESSIBILITY_SERVICE
             权限仅授予系统，exported=true 不会带来第三方绑定风险。 -->
        <service
            android:name=".receiver.ProxyAutoStartAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

    </application>

</manifest>
